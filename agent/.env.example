APP_HOME=/opt/hakkawine
LOG_LEVEL=info

LOCAL_API_LISTEN=127.0.0.1:9999
LOCAL_API_SECRET=your_local_controller_secret
PID_FILE=/opt/hakkawine/data/hakkawine.pid

DATABASE_URL=sqlite:///opt/hakkawine/data/hakkawine.db?mode=rwc

WEB_WS_URL=wss://hakkawine.dev/agent/v1/stream
WEB_CLIENT_ID=your_auth_app_id
WEB_CLIENT_SECRET=your_auth_secret_key

CORE_TYPE=mihomo
CORE_BIN_PATH=/opt/hakkawine/bin/mihomo